<Window x:Class="Saman.UI.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تنظیمات" Width="820" Height="640" FlowDirection="RightToLeft" FontFamily="Vazirmatn, Tahoma" Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="6,5"/><Setter Property="Width" Value="230"/></Style>
    <Style TargetType="TextBlock" x:Key="Hint"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#4A5A56"/></Style>
    <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  </Window.Resources>
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="ذخیره تنظیمات" Padding="24,8" Click="Save_Click" Background="{StaticResource Copper}" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
      <TextBlock x:Name="Msg" VerticalAlignment="Center" Margin="14,0" Foreground="{StaticResource Pcb2}"/>
    </StackPanel>
    <TabControl>
      <TabItem Header="رسید و چاپ"><ScrollViewer Padding="10"><StackPanel>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="رسید پذیرش" FontWeight="Bold" Foreground="{StaticResource Pcb2}" Margin="0,0,0,10"/>
          <DockPanel Margin="0,0,0,12"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
              <RadioButton x:Name="RbA5" Content="A5" Margin="0,0,14,0"/><RadioButton x:Name="RbThermal" Content="حرارتی ۸۰ میلی‌متر" Margin="0,0,14,0"/><RadioButton x:Name="RbBoth" Content="هر دو"/></StackPanel>
            <StackPanel><TextBlock Text="اندازه رسید"/><TextBlock Text="پس از ثبت پذیرش با این اندازه چاپ می‌شود" Style="{StaticResource Hint}"/></StackPanel></DockPanel>
          <DockPanel Margin="0,0,0,12"><TextBox x:Name="TbShop" DockPanel.Dock="Left"/><TextBlock Text="نام مرکز روی رسید" VerticalAlignment="Center"/></DockPanel>
          <DockPanel Margin="0,0,0,12"><TextBox x:Name="TbPhone" DockPanel.Dock="Left" FlowDirection="LeftToRight"/>
            <StackPanel><TextBlock Text="تلفن روی رسید"/><TextBlock Text="اختیاری؛ خالی بماند چاپ نمی‌شود" Style="{StaticResource Hint}"/></StackPanel></DockPanel>
          <DockPanel><TextBox x:Name="TbUrl" DockPanel.Dock="Left" FlowDirection="LeftToRight"/>
            <StackPanel><TextBlock Text="نشانی صفحه پیگیری برای QR"/><TextBlock Text="اختیاری؛ خالی بماند QR فقط شماره پذیرش را دارد" Style="{StaticResource Hint}"/></StackPanel></DockPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="گارانتی تعمیر" FontWeight="Bold" Foreground="{StaticResource Pcb2}" Margin="0,0,0,10"/>
          <DockPanel><TextBox x:Name="TbWarranty" DockPanel.Dock="Left" FlowDirection="LeftToRight"/>
            <StackPanel><TextBlock Text="مدت گارانتی تعمیر (روز)"/><TextBlock Text="تا وارد نکنید، عبارت «در مدت گارانتی» نمایش داده نمی‌شود" Style="{StaticResource Hint}"/></StackPanel></DockPanel>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="اطلاعات مرکز"><TextBlock Text="در مرحله بعد ساخته می‌شود." Margin="20" Style="{StaticResource Hint}"/></TabItem>
      <TabItem Header="گارانتی و SLA"><TextBlock Text="در مرحله بعد ساخته می‌شود." Margin="20" Style="{StaticResource Hint}"/></TabItem>
      <TabItem Header="صنف‌ها و قالب‌ها"><TextBlock Text="در مرحله بعد ساخته می‌شود." Margin="20" Style="{StaticResource Hint}"/></TabItem>
      <TabItem Header="بکاپ"><TextBlock Text="در مرحله بعد ساخته می‌شود." Margin="20" Style="{StaticResource Hint}"/></TabItem>
    </TabControl>
  </DockPanel>
</Window>
